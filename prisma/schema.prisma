generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id                 String   @id @default(uuid())
  slug               String   @unique
  title              String
  subtitle           String?
  shortDescription   String
  shortDescriptionEn String?
  longDescription    String
  coverImage         String
  pdfFileName        String
  language           String
  format             String   @default("PDF")
  pageCount          String?
  edition            String
  publicationDate   String?
  priceInPaise       Int
  mrpInPaise         Int
  category           String   @default("UPSC EPFO / APFC")
  displayOrder       Int      @default(0)
  published          Boolean  @default(true)
  highlights         String   // JSON string of array
  samplePages        String   // JSON string of array of image URLs
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Order {
  id                String   @id @default(uuid())
  orderRef          String   @unique // Public Order Reference (e.g. GP-1788035684346-6595)
  productId         String
  productTitle      String
  customerName      String
  customerEmail     String
  customerPhone     String?
  amountInPaise     Int
  currency          String   @default("INR")
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  razorpaySignature String?
  status            String   @default("PENDING") // PENDING, PAID, FAILED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PurchaseEntitlement {
  id            String   @id @default(uuid())
  orderId       String
  orderRef      String   @unique
  customerEmail String
  customerName  String?
  productId     String
  productSlug   String
  productTitle  String
  status        String   @default("ACTIVE") // ACTIVE, REVOKED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DownloadToken {
  id               String    @id @default(uuid())
  tokenHash        String    @unique // SHA-256 hash of the cryptographically random token
  rawTokenPreview  String?   // Short 8-char preview for log inspection
  orderId          String
  orderRef         String
  customerEmail    String
  productId        String
  expiresAt        DateTime
  downloadCount    Int       @default(0)
  maxDownloads     Int       @default(15) // Rate limit downloads per purchase
  lastDownloadedAt DateTime?
  createdAt        DateTime  @default(now())
}

model WebhookEvent {
  id         String   @id @default(uuid())
  eventId    String   @unique // x-razorpay-event-id or webhook event ID for idempotency
  eventType  String
  payload    String   // Raw event JSON
  status     String   @default("PROCESSED") // PROCESSED, IGNORED, FAILED
  createdAt  DateTime @default(now())
}
